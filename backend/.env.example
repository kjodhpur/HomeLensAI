# Optional — defaults work for local development.
# Comma-separated browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:3000
# Allow any https://*.vercel.app origin (preview deployments). Set to 0 to disable.
CORS_ALLOW_VERCEL_PREVIEWS=1
# Folder with provider_risk.json / summary.json / aspect_lexicon.json (default: backend/app/data)
# HOMELENS_DATA_DIR=
